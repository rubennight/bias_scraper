# .env.example — variables de entorno de bias_scraper
# Copiar a .env en la raíz y rellenar con valores reales.
# Usado por: api/ (Node), scraper/ (Python) y docker-compose.yml.
# En Docker estas mismas variables se inyectan directo al contenedor
# vía docker-compose.yml — no hace falta un archivo .env dentro de él.

# ── PostgreSQL — leído por api/db.js y scraper/db.py ───────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bias_scraper
DB_USER=postgres
DB_PASSWORD=

# ── api/ (Express) ──────────────────────────────────────────────
# Puerto donde escucha el backend.
PORT=3001

# Orígenes permitidos por CORS, separados por coma. Incluir tanto el
# dev server local como el dominio público una vez expuesto.
CORS_ORIGIN=http://localhost:5173,https://bias-scraper.ru-byte.com

# Clave requerida en el header X-API-Key para POST /api/scraper/run.
# Ese endpoint dispara el pipeline pesado (scraping + NLP) — sin esta
# key configurada, la ruta responde 500 en vez de abrirse por defecto.
# Generar una key fuerte, ej.: openssl rand -hex 32
SCRAPER_API_KEY=

# ── web/ (Vite) ──────────────────────────────────────────────────
# Ver web/.env.example — VITE_API_URL vive en un .env aparte porque
# Vite solo lee variables desde la carpeta del propio proyecto frontend.
