# .env.example — variables de entorno de bias_scraper
# Copiar a .env en la raíz y rellenar con valores reales.
# Usado por: api/ (Node), scraper/ (Python) y docker-compose.yml.
# En Docker estas mismas variables se inyectan directo al contenedor
# vía docker-compose.yml — no hace falta un archivo .env dentro de él.

# ── PostgreSQL — leído por api/db.js y scraper/db.py ───────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bias_scraper
DB_USER=postgres
DB_PASSWORD=

# ── api/ (Express) ──────────────────────────────────────────────
# Puerto donde escucha el backend.
PORT=3001

# Orígenes permitidos por CORS, separados por coma. Incluir tanto el
# dev server local como el dominio público una vez expuesto.
CORS_ORIGIN=http://localhost:5173,https://bias-scraper.ru-byte.com

# Clave compartida entre api/ y scraper/ — api/routes/scraper.js la
# envía como header X-API-Key al pedirle a scraper/server.py que
# dispare el pipeline; scraper/server.py la valida de nuevo antes de
# ejecutarlo. Sin esta key configurada en CUALQUIERA de los dos lados,
# la ruta correspondiente responde 500 en vez de abrirse por defecto.
# Generar una key fuerte, ej.: openssl rand -hex 32
SCRAPER_API_KEY=

# Secreto para firmar/verificar los JWT de sesión de usuario (login,
# tabla `usuarios`) — distinto de SCRAPER_API_KEY, que es un mecanismo
# aparte (api → scraper, servidor-servidor, no de usuarios).
# Generar una key fuerte, ej.: openssl rand -hex 32
JWT_SECRET=

# NODE_ENV=production hace que la cookie de sesión salga con el flag
# Secure (requiere HTTPS) — dejar SIN definir en dev local (HTTP) para
# que el login siga funcionando ahí; en producción va en
# docker-compose.yml, no hace falta repetirlo aquí.
# NODE_ENV=production

# ── scraper/ (Flask, server.py) ─────────────────────────────────
# URL interna donde api/ encuentra al servicio scraper. En Docker
# Compose el default ya apunta al nombre del servicio (http://scraper:8000)
# — normalmente no hace falta declarar esta variable, solo existe por
# si el puerto o el nombre del servicio cambian.
# SCRAPER_URL=http://scraper:8000

# ── web/ (Vite) ──────────────────────────────────────────────────
# Ver web/.env.example — VITE_API_URL vive en un .env aparte porque
# Vite solo lee variables desde la carpeta del propio proyecto frontend.
