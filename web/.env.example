# web/.env.example — copiar a web/.env y ajustar valores reales.
# Variables VITE_* se inyectan en tiempo de build (Vite) y quedan
# visibles en el bundle final del navegador — nunca poner secretos aquí.

# URL pública del backend (api/). En desarrollo local usa el fallback
# del código (http://localhost:3001) si esta variable no está definida.
VITE_API_URL=http://localhost:3001
